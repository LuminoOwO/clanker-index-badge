{
  "name": "clanker-index-badge",
  "version": "1.0.0",
  "description": "A README badge showing how much of a repo was made by which AI, per category.",
  "type": "module",
  "bin": {
    "clanker-index": "dist/cli.js"
  },
  "main": "src/generate.js",
  "files": [
    "dist",
    "src",
    "action.yml"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "examples": "node scripts/examples.js",
    "badge": "node src/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "badge",
    "ai",
    "attribution",
    "readme",
    "github-action",
    "clanker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuminoOwO/clanker-index-badge.git"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
